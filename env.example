NEXT_PUBLIC_WAYBILL_PREFIX=LCC
NEXT_PUBLIC_WAYBILL_PAD=6
NEXT_PUBLIC_WAYBILL_PDF_COPIES=3

# Optional seed for in-memory fallback numbering used in local development.
WAYBILL_SEED=0
WAYBILL_COUNTER_KEY=waybill:number:primary

# Configure either Vercel KV or Supabase (or both) for persistent waybill counters.

# Vercel KV configuration
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Supabase configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

